{
  "name": "hiverouter-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playwright e2e + trace harness for HiveMind v1 (installed Chrome/Edge channels only; no browser download)",
  "devDependencies": {
    "@playwright/test": "1.65.0"
  },
  "scripts": {
    "e2e": "node run-guarded.mjs",
    "e2e:raw": "playwright test",
    "e2e:chrome": "node run-guarded.mjs --project=chrome",
    "e2e:guarded": "node run-guarded.mjs",
    "e2e:msedge": "node run-guarded.mjs --project=msedge",
    "verify:harness": "node ../tools/qa/verify-harness.mjs",
    "verify:figcraft": "node ../tools/qa/figcraft-assets.mjs",
    "seeds": "node ../tools/qa/build-trace-seeds.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

