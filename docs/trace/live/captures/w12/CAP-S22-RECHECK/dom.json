  "html": "<!DOCTYPE html><html lang=\"en\" data-reduced-motion=\"false\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"color-scheme\" content=\"light\">\n    <meta name=\"theme-color\" content=\"#F8F4EB\">\n    <title>HiveMind — Spatial Execution Environment</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23282010'/%3E%3Cpath d='M32 10l19 11v22L32 54 13 43V21z' fill='%23F0C050'/%3E%3C/svg%3E\">\n    <script type=\"module\" crossorigin=\"\" src=\"/assets/index-DrhKHEbk.js\"></script>\n    <link rel=\"stylesheet\" crossorigin=\"\" href=\"/assets/index-CfG-Ernd.css\">\n  </head>\n  <body>\n    <div id=\"root\"><div class=\"flex h-full min-h-0 bg-canvas text-ink-900\"><a class=\"skip-link\" href=\"#hive-canvas\">Skip to canvas</a><nav aria-label=\"Primary navigation\" class=\"flex w-[72px] shrink-0 flex-col items-center gap-1 border-r border-hairline bg-panel py-3\"><div class=\"type-mono-meta mb-1 text-meta\" aria-hidden=\"true\">HM</div><button type=\"button\" aria-current=\"page\" tabindex=\"0\" class=\"flex h-11 w-14 items-center justify-center rounded-[var(--radius-md)] border px-1 text-center text-[10px] leading-tight border-honey-400 bg-honey-100 text-ink-900\">Workspace</button><button type=\"button\" tabindex=\"-1\" class=\"flex h-11 w-14 items-center justify-center rounded-[var(--radius-md)] border px-1 text-center text-[10px] leading-tight border-transparent text-ink-500 hover:border-hairline hover:bg-panel-alt\">Agents</button><button type=\"button\" tabindex=\"-1\" class=\"flex h-11 w-14 items-center justify-center rounded-[var(--radius-md)] border px-1 text-center text-[10px] leading-tight border-transparent text-ink-500 hover:border-hairline hover:bg-panel-alt\">Data</button><button type=\"button\" tabindex=\"-1\" class=\"flex h-11 w-14 items-center