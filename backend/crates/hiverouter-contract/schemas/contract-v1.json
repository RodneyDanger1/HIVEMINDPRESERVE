          "description": "One agent/node/run state.\n\nThe frozen minimum set is 15 values (`healthy .. loading`); `Interrupted` is\na recorded superset addition needed by the Phase 9 crash-recovery read model\n(a run killed mid-flight must be distinguishable from `cancelled`).",
          "oneOf": [
            {
              "description": "Node is healthy and idle.",
              "type": "string",
              "const": "healthy"
            },
            {
              "description": "Node is executing.",
              "type": "string",
              "const": "running"
            },
            {
              "description": "Node is queued and has not started.",
              "type": "string",
              "const": "queued"
            },
            {
              "description": "Node/run failed.",
              "type": "string",
              "const": "failed"
            },
            {
              "description": "Node/run completed.",
              "type": "string",
              "const": "completed"
            },
            {
              "description": "Run was cancelled by the user.",
              "type": "string",
              "const": "cancelled"
            },
            {
              "description": "Worker was killed by `KILL_WORKER`.",
              "type": "string",
              "const": "killed"
            },
            {
              "description": "Agent is planning (intent -> task DAG).",
              "type": "string",
              "const": "planning"
            },
            {
              "description": "Agent is thinking (model reasoning phase).",
              "type": "string",
              "const": "thinking"
            },
            {
              "description": "Agent is waiting for an approval decision.",
              "type": "string",
              "const": "awaiting_approval"
            },
            {
              "description": "Agent reply is streaming.",
              "type": "string",
              "const": "streaming"
            },
            {
              "description": "Client-side transport state: reconnecting.",
              "type": "string",
              "const": "reconnecting"
            },
            {
              "description": "Client-side transport state: replaying buffered events.",
              "type": "string",
              "const": "replay"
            },
            {
              "description": "No data yet.",
              "type": "string",
              "const": "empty"
            },
            {
              "description": "Data is loading.",
              "type": "string",
              "const": "loading"
            },
            {
              "description": "Run was interrupted by a crash/restart and recovered from a snapshot.",
              "type": "string",
              "const": "interrupted"
            }
          ]
        }
      }
    },
