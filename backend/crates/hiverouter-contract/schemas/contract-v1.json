    "NODE_SPAWN": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NodeEvent",
      "description": "`NODE_SPAWN` / `NODE_DRAG` / `NODE_REWIRE` / `NODE_STATE` payload (frozen\ncontract: `task_id`, `state`).",
      "type": "object",
      "properties": {
